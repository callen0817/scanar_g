  <buildtool_depend>cmake</buildtool_depend>
  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>session_manager</exec_depend>
  <exec_depend>diagnostics</exec_depend>
  <exec_depend>packet_capture</exec_depend>
  <exec_depend>continuous_capture</exec_depend>
  <exec_depend>scanar_slam_bridge</exec_depend>
  <exec_depend>scanar_verification</exec_depend>
